{
  "name": "DeskBuddy - Original M5StickC",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m venv .venv && .venv/bin/pip install --upgrade pip platformio",
  "customizations": {
